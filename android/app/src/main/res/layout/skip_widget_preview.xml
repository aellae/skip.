<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview (skip_widget_info.xml's previewLayout). The picker
     inflates this statically without running SkipHomeWidgetProvider, so unlike
     skip_widget.xml every text and color is baked in here: a Minimal-aesthetic
     sample of the small layout with example totals. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/skip_widget_bg_minimal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/skip_widget_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="end"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:text="@string/skip_widget_preview_month"
                android:textColor="#802C302E"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/skip_widget_saved_label"
            android:textColor="#8C2C302E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:singleLine="true"
            android:text="@string/skip_widget_preview_saved"
            android:textColor="#5C7A5A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.12"
            android:text="@string/skip_widget_spent_label"
            android:textColor="#8C2C302E"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:singleLine="true"
            android:text="@string/skip_widget_preview_spent"
            android:textColor="#A35656"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ProgressBar
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progress="73"
            android:progressDrawable="@drawable/skip_widget_bar_minimal"
            android:secondaryProgress="100" />
    </LinearLayout>
</FrameLayout>
