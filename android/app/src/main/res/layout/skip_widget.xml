<?xml version="1.0" encoding="utf-8"?>
<!-- RemoteViews layout for SkipHomeWidgetProvider. Visual twin of
     ios/SkipWidget/SkipWidget.swift's small SkipWidgetEntryView: brand logo +
     month header, Saved/Spent stat blocks, and a saved-vs-spent split bar, on
     a rounded card styled per aesthetic. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY"
        android:src="@drawable/skip_widget_bg_minimal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitStart"
                android:src="@drawable/skip_widget_logo" />

            <TextView
                android:id="@+id/widget_month"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:letterSpacing="0.12"
                android:singleLine="true"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="SEP" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="6dp" />

        <TextView
            android:id="@+id/widget_saved_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="● SAVED" />

        <TextView
            android:id="@+id/widget_saved_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="20sp"
            tools:text="$120.00" />

        <TextView
            android:id="@+id/widget_spent_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.12"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="● SPENT" />

        <TextView
            android:id="@+id/widget_spent_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textSize="20sp"
            tools:text="$45.00" />

        <!-- One bar per aesthetic (RemoteViews can't swap a ProgressBar's
             progressDrawable); the provider shows the matching one. -->
        <ProgressBar
            android:id="@+id/widget_bar_minimal"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/skip_widget_bar_minimal" />

        <ProgressBar
            android:id="@+id/widget_bar_y2k"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="10dp"
            android:max="100"
            android:progressDrawable="@drawable/skip_widget_bar_y2k"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
