<?xml version="1.0" encoding="utf-8"?>
<!-- Saved-vs-spent split bar for the "SKIP!" aesthetic: progress = saved share,
     secondaryProgress (100 whenever anything's logged) = spent remainder,
     background = empty track. See SkipHomeWidgetProvider. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="#24E0E0E0" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="#FF5FC8" />
            </shape>
        </clip>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="#00E5FF" />
            </shape>
        </clip>
    </item>
</layer-list>
